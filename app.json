        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "# The local Expo module and the widget provider are both resolved by\n# NAME rather than by a direct reference — expo-modules-core\n# instantiates modules reflectively, and the AppWidgetProvider is only\n# named in AndroidManifest.xml. R8 breakage in either surfaces as a\n# runtime crash, not a build failure.\n-keep class expo.modules.widgetdata.** { *; }\n-keep class com.ishank1995.dharmagya.widget.** { *; }\n\n# Mirrors the generated proguard-rules.pro, which prebuild rewrites.\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }"
          }
        }
      ]
