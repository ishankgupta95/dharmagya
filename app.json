{
  "expo": {
    "name": "dharmagya",
    "slug": "dharmSetu",
    "version": "1.8.0",
    "orientation": "portrait",
    "icon": "./assets/images/dharmagya_logo_small.png",
    "scheme": "dharmagya",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ishank1995.dharmagya"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/dharmagya_logo_small.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ishank1995.dharmagya",
      "versionCode": 10
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/dharmagya_logo_small.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/dharmagya_logo_small.png",
          "color": "#E8893C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/dharmagya_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3308993640799405~9721445524",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-localization",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow dharmagya to save shareable cards to your photos.",
          "savePhotosPermission": "Allow dharmagya to save shareable cards to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "react-native-edge-to-edge",
      "@react-native-community/datetimepicker",
      "./plugins/withTodayPanchangWidget"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d52dbe9d-4258-446f-a902-32e801d580a9"
      }
    },
    "owner": "ishank1995"
  }
}
